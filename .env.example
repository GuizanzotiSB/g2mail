# ---------- App ----------
APP_URL=https://mail.g2edu.com.br            # URL pública (usada em links de rastreio e webhooks)
APP_TIMEZONE=America/Sao_Paulo
ADMIN_PASSWORD=troque-esta-senha              # senha do painel
MASTER_API_KEY=g2m_troque-esta-chave          # chave mestra (REST + MCP + cron). Gere outras no painel.
CRON_SECRET=                                  # opcional; se vazio usa a MASTER_API_KEY

# ---------- Supabase (projeto onde rodou supabase/migrations/001_schema.sql) ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Listmonk ----------
# No docker-compose o app fala com o Listmonk pela rede interna (http://listmonk:9000).
# Crie um usuário de API no Listmonk (Users → New → type API) e cole aqui:
LISTMONK_URL=http://listmonk:9000
LISTMONK_USER=g2mail
LISTMONK_PASSWORD=
LISTMONK_AUTH=token                           # "token" para usuário de API (v4+); "basic" para usuário/senha
LISTMONK_DB_PASSWORD=troque-esta-senha-do-postgres
